# ── Database (Postgres 16) ──────────────────────────────────
POSTGRES_USER=akshanet
POSTGRES_PASSWORD=akshanet_dev
POSTGRES_DB=akshanet
POSTGRES_PORT=5432
DATABASE_URL=postgresql://akshanet:akshanet_dev@localhost:5432/akshanet

# ── Redis 7 ────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── MinIO (S3-compatible object storage) ───────────────────
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=akshanet-uploads

# ── JWT / Auth ─────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production-refresh
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── APAAR Verification API ────────────────────────────────
APAAR_API_URL=https://apaar.example.gov.in/api/v1
APAAR_API_KEY=your-apaar-api-key

# ── ML Service ─────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000

# ── App Ports ──────────────────────────────────────────────
API_PORT=3000
WEB_PORT=5173
STUDENT_PWA_PORT=5174
EMPLOYER_PORT=5175

# ── Environment ───────────────────────────────────────────
NODE_ENV=development
