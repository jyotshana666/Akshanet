# Akshanet API — Environment Variables
# Copy to .env and replace CHANGE_ME values

DATABASE_URL=postgresql://akshanet:CHANGE_ME@localhost:5432/akshanet
REDIS_URL=redis://localhost:6379

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=akshanet-uploads

JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_AT_LEAST_32_CHARS
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

APAAR_API_URL=https://apaar.example.gov.in/api/v1
APAAR_API_KEY=CHANGE_ME
APAAR_MOCK=true

ML_SERVICE_URL=http://localhost:8000

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM=noreply@akshanet.in

TWILIO_SID=CHANGE_ME
TWILIO_TOKEN=CHANGE_ME
TWILIO_FROM=+1234567890

API_PORT=3000
NODE_ENV=development
